# Copy to .env and fill in. Never commit .env.

# --- LLM (required for generation with provider=anthropic, test-set generation, RAGAS judge)
ANTHROPIC_API_KEY=

# --- Vector store: ":memory:" | local path (e.g. data/qdrant) | http://host:6333
QDRANT_URL=data/qdrant
QDRANT_API_KEY=

# --- Response cache (needed when cache.backend=redis)
REDIS_URL=redis://localhost:6379/0

# --- Langfuse tracing (leave empty to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Pipeline config file (behaviour lives in YAML, not env)
RAG_CONFIG=configs/local.yaml
LOG_LEVEL=INFO
LOG_JSON=true
